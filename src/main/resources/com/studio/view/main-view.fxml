<?xml version="1.0" encoding="UTF-8"?>

<!--
    Главное окно приложения «Студия звукозаписи».

    FXML описывает только внешний вид: какие элементы есть и как они расположены.
    fx:controller — класс, который управляет этим окном.
    fx:id        — имя поля в контроллере (с аннотацией @FXML), куда FXMLLoader
                   подставит созданный элемент.
    onAction="#имяМетода" — метод контроллера, вызываемый при нажатии/выборе.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studio.controller.MainController"
            styleClass="root-pane">

    <!-- ================= ВЕРХ: заголовок и состояние подключения ================= -->
    <top>
        <!-- Заголовок приложения и состояние подключения к БД -->
        <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="14">
            <StackPane styleClass="rec-mark">
                <Region styleClass="rec-dot"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="Студия звукозаписи" styleClass="app-title"/>
                <Label text="Учёт заказов на студийную запись" styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="connectionLabel" text="Подключение…" styleClass="connection-badge"/>
        </HBox>
    </top>

    <!-- ================= ЦЕНТР: вкладки «Заказы» и «Клиенты» ================= -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="main-tabs">

            <!-- ===== Вкладка «Заказы»: действия, поиск/фильтры, таблица и карточка ===== -->
            <Tab text="Заказы">
                <BorderPane>
                    <top>
                        <VBox>
                            <!-- Панель действий с записями -->
                            <HBox styleClass="action-bar" alignment="CENTER_LEFT" spacing="8">
                                <Button text="Добавить" onAction="#onAdd" styleClass="button-primary">
                                    <tooltip><Tooltip text="Создать новый заказ на запись"/></tooltip>
                                </Button>
                                <Button fx:id="editButton" text="Изменить" onAction="#onEdit">
                                    <tooltip><Tooltip text="Изменить выбранный заказ (или двойной щелчок по строке)"/></tooltip>
                                </Button>
                                <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete" styleClass="button-danger">
                                    <tooltip><Tooltip text="Удалить выбранный заказ (с подтверждением)"/></tooltip>
                                </Button>
                                <Separator orientation="VERTICAL"/>
                                <Button text="Обновить" onAction="#onRefresh">
                                    <tooltip><Tooltip text="Заново загрузить данные из базы"/></tooltip>
                                </Button>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Статистика" onAction="#onStatistics">
                                    <tooltip><Tooltip text="Показатели по заказам студии"/></tooltip>
                                </Button>
                                <Button text="Экспорт" onAction="#onExport">
                                    <tooltip><Tooltip text="Выгрузить текущий список заказов в файл"/></tooltip>
                                </Button>
                            </HBox>

                            <!-- Поиск, фильтрация и сортировка -->
                            <FlowPane styleClass="filter-bar" hgap="12" vgap="10">
                                <VBox styleClass="filter-group">
                                    <Label text="Поиск" styleClass="filter-label"/>
                                    <TextField fx:id="searchField" prefWidth="290"
                                               promptText="Название, описание или клиент"/>
                                </VBox>
                                <VBox styleClass="filter-group">
                                    <Label text="Статус" styleClass="filter-label"/>
                                    <ComboBox fx:id="statusFilter" prefWidth="160" onAction="#onFilterChanged"/>
                                </VBox>
                                <VBox styleClass="filter-group">
                                    <Label text="Тип записи" styleClass="filter-label"/>
                                    <ComboBox fx:id="typeFilter" prefWidth="150" onAction="#onFilterChanged"/>
                                </VBox>
                                <VBox styleClass="filter-group">
                                    <Label text="Приоритет" styleClass="filter-label"/>
                                    <ComboBox fx:id="priorityFilter" prefWidth="150" onAction="#onFilterChanged"/>
                                </VBox>
                                <VBox styleClass="filter-group">
                                    <Label text="Сортировка" styleClass="filter-label"/>
                                    <HBox spacing="6">
                                        <ComboBox fx:id="sortFieldBox" prefWidth="150" onAction="#onFilterChanged"/>
                                        <ComboBox fx:id="sortDirectionBox" prefWidth="165" onAction="#onFilterChanged"/>
                                    </HBox>
                                </VBox>
                                <VBox styleClass="filter-group" alignment="BOTTOM_LEFT">
                                    <Label text=" " styleClass="filter-label"/>
                                    <Button text="Сбросить" onAction="#onResetFilters"
                                            styleClass="button-link"/>
                                </VBox>
                            </FlowPane>
                        </VBox>
                    </top>

                    <!-- Таблица заказов + карточка выбранного заказа -->
                    <center>
                        <HBox spacing="14" styleClass="content">
                            <TableView fx:id="ordersTable" HBox.hgrow="ALWAYS" styleClass="orders-table">
                                <columns>
                                    <TableColumn fx:id="idColumn" text="№" prefWidth="55" sortable="false"/>
                                    <TableColumn fx:id="titleColumn" text="Название" prefWidth="170" sortable="false"/>
                                    <TableColumn fx:id="clientColumn" text="Клиент" prefWidth="150" sortable="false"/>
                                    <TableColumn fx:id="typeColumn" text="Тип" prefWidth="95" sortable="false"/>
                                    <TableColumn fx:id="dateColumn" text="Дата записи" prefWidth="105" sortable="false"/>
                                    <TableColumn fx:id="hoursColumn" text="Часы" prefWidth="60" sortable="false"/>
                                    <TableColumn fx:id="priceColumn" text="Стоимость" prefWidth="100" sortable="false"/>
                                    <TableColumn fx:id="priorityColumn" text="Приоритет" prefWidth="95" sortable="false"/>
                                    <TableColumn fx:id="statusColumn" text="Статус" prefWidth="140" minWidth="135" sortable="false"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                                </columnResizePolicy>
                            </TableView>

                            <!-- Карточка выбранного заказа: просмотр без обращения к БД вручную -->
                            <ScrollPane styleClass="details-scroll" fitToWidth="true"
                                        prefWidth="310" minWidth="270" maxWidth="340">
                                <VBox styleClass="details-card" spacing="12">
                                    <Label text="КАРТОЧКА ЗАКАЗА" styleClass="section-caption"/>

                                    <Label fx:id="detailsPlaceholder" wrapText="true" styleClass="details-placeholder"
                                           text="Выберите заказ в таблице, чтобы увидеть подробности."/>

                                    <VBox fx:id="detailsContent" spacing="12" visible="false" managed="false">
                                        <VBox spacing="6">
                                            <Label fx:id="detailsTitle" wrapText="true" styleClass="details-title"/>
                                            <Label fx:id="detailsStatus" styleClass="status-badge"/>
                                        </VBox>
                                        <Label fx:id="detailsDescription" wrapText="true" styleClass="details-description"/>
                                        <Separator/>
                                        <GridPane hgap="12" vgap="8">
                                            <columnConstraints>
                                                <ColumnConstraints minWidth="100" prefWidth="100"/>
                                                <ColumnConstraints hgrow="ALWAYS"/>
                                            </columnConstraints>
                                            <Label text="Клиент" styleClass="details-key" GridPane.rowIndex="0"/>
                                            <Label fx:id="detailsClient" wrapText="true" styleClass="details-value"
                                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                            <Label text="Телефон" styleClass="details-key" GridPane.rowIndex="1"/>
                                            <Label fx:id="detailsPhone" styleClass="details-value"
                                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                            <Label text="Тип записи" styleClass="details-key" GridPane.rowIndex="2"/>
                                            <Label fx:id="detailsType" styleClass="details-value"
                                                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                            <Label text="Приоритет" styleClass="details-key" GridPane.rowIndex="3"/>
                                            <Label fx:id="detailsPriority" styleClass="details-value"
                                                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                                            <Label text="Дата записи" styleClass="details-key" GridPane.rowIndex="4"/>
                                            <Label fx:id="detailsDate" styleClass="details-value"
                                                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                                            <Label text="Длительность" styleClass="details-key" GridPane.rowIndex="5"/>
                                            <Label fx:id="detailsHours" styleClass="details-value"
                                                   GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                                            <Label text="Стоимость" styleClass="details-key" GridPane.rowIndex="6"/>
                                            <Label fx:id="detailsPrice" styleClass="details-value, details-price"
                                                   GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                                        </GridPane>
                                        <Separator/>
                                        <GridPane hgap="12" vgap="6">
                                            <columnConstraints>
                                                <ColumnConstraints minWidth="100" prefWidth="100"/>
                                                <ColumnConstraints hgrow="ALWAYS"/>
                                            </columnConstraints>
                                            <Label text="Создан" styleClass="details-key, details-muted" GridPane.rowIndex="0"/>
                                            <Label fx:id="detailsCreated" styleClass="details-muted"
                                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                            <Label text="Изменён" styleClass="details-key, details-muted" GridPane.rowIndex="1"/>
                                            <Label fx:id="detailsUpdated" styleClass="details-muted"
                                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                        </GridPane>
                                    </VBox>
                                </VBox>
                            </ScrollPane>

                            <padding>
                                <Insets top="14" right="16" bottom="12" left="16"/>
                            </padding>
                        </HBox>
                    </center>
                </BorderPane>
            </Tab>

            <!-- ===== Вкладка «Клиенты»: таблица клиентов студии ===== -->
            <Tab text="Клиенты">
                <BorderPane>
                    <top>
                        <HBox styleClass="action-bar" alignment="CENTER_LEFT" spacing="8">
                            <Label text="Клиенты студии" styleClass="tab-title"/>
                            <Label fx:id="clientsCountLabel" styleClass="status-muted"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Обновить" onAction="#onRefresh">
                                <tooltip><Tooltip text="Заново загрузить данные из базы"/></tooltip>
                            </Button>
                        </HBox>
                    </top>
                    <center>
                        <!-- Технические поля (дата создания записи в БД) не показываются -->
                        <TableView fx:id="clientsTable" styleClass="clients-table">
                            <columns>
                                <TableColumn fx:id="clientIdColumn" text="№" prefWidth="55"/>
                                <TableColumn fx:id="clientNameColumn" text="ФИО / название" prefWidth="220"/>
                                <TableColumn fx:id="clientRoleColumn" text="Роль" prefWidth="160"/>
                                <TableColumn fx:id="clientEmailColumn" text="Email" prefWidth="200"/>
                                <TableColumn fx:id="clientPhoneColumn" text="Телефон" prefWidth="140"/>
                                <TableColumn fx:id="clientOrdersColumn" text="Заказов" prefWidth="90"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                            </columnResizePolicy>
                            <BorderPane.margin>
                                <Insets top="14" right="16" bottom="12" left="16"/>
                            </BorderPane.margin>
                        </TableView>
                    </center>
                </BorderPane>
            </Tab>
        </TabPane>
    </center>

    <!-- ================= НИЗ: строка состояния ================= -->
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="countLabel" styleClass="status-count"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="messageLabel" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label fx:id="lastUpdatedLabel" styleClass="status-muted"/>
        </HBox>
    </bottom>
</BorderPane>
