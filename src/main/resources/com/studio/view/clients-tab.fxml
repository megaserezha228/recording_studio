<?xml version="1.0" encoding="UTF-8"?>

<!--
    Вкладка «Клиенты» главного окна. Подключается в main-view.fxml через fx:include,
    у неё свой контроллер — ClientsTabController.

    Слева — таблица клиентов, справа — карточка выбранного клиента и его заказы
    (связанные данные: recording_orders.client_id → clients.id).
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studio.controller.ClientsTabController">

    <top>
        <HBox styleClass="action-bar" alignment="CENTER_LEFT" spacing="8">
            <Label text="Клиенты студии" styleClass="tab-title"/>
            <Label fx:id="clientsCountLabel" styleClass="status-muted"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Обновить" onAction="#onRefresh">
                <tooltip><Tooltip text="Заново загрузить данные из базы"/></tooltip>
            </Button>
        </HBox>
    </top>

    <center>
        <HBox spacing="14" styleClass="content">
            <!-- Технические поля (дата создания записи в БД) в таблице не показываются -->
            <TableView fx:id="clientsTable" HBox.hgrow="ALWAYS" styleClass="clients-table">
                <columns>
                    <TableColumn fx:id="clientIdColumn" text="№" prefWidth="55"/>
                    <TableColumn fx:id="clientNameColumn" text="ФИО / название" prefWidth="190"/>
                    <TableColumn fx:id="clientRoleColumn" text="Роль" prefWidth="150"/>
                    <TableColumn fx:id="clientEmailColumn" text="Email" prefWidth="160"/>
                    <TableColumn fx:id="clientPhoneColumn" text="Телефон" prefWidth="125"/>
                    <TableColumn fx:id="clientOrdersColumn" text="Заказов" prefWidth="80"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>

            <!-- Карточка клиента и связанные с ним заказы -->
            <ScrollPane styleClass="details-scroll" fitToWidth="true"
                        prefWidth="400" minWidth="340" maxWidth="440">
                <VBox styleClass="details-card" spacing="12">
                    <Label text="КАРТОЧКА КЛИЕНТА" styleClass="section-caption"/>

                    <Label fx:id="clientPlaceholder" wrapText="true" styleClass="details-placeholder"
                           text="Выберите клиента в таблице, чтобы увидеть его данные и заказы."/>

                    <VBox fx:id="clientDetails" spacing="12" visible="false" managed="false">
                        <VBox spacing="4">
                            <Label fx:id="clientName" wrapText="true" styleClass="details-title"/>
                            <Label fx:id="clientRole" styleClass="role-badge"/>
                        </VBox>
                        <GridPane hgap="12" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints minWidth="90" prefWidth="90"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Email" styleClass="details-key" GridPane.rowIndex="0"/>
                            <Label fx:id="clientEmail" wrapText="true" styleClass="details-value"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Телефон" styleClass="details-key" GridPane.rowIndex="1"/>
                            <Label fx:id="clientPhone" styleClass="details-value"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="Клиент с" styleClass="details-key" GridPane.rowIndex="2"/>
                            <Label fx:id="clientSince" styleClass="details-value"
                                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        </GridPane>

                        <Separator/>

                        <Label text="ЗАКАЗЫ КЛИЕНТА" styleClass="section-caption"/>
                        <Label fx:id="clientOrdersSummary" wrapText="true" styleClass="details-value"/>
                        <TableView fx:id="clientOrdersTable" prefHeight="230" styleClass="client-orders-table">
                            <columns>
                                <TableColumn fx:id="orderTitleColumn" text="Заказ" prefWidth="120"/>
                                <TableColumn fx:id="orderDateColumn" text="Дата" prefWidth="80"/>
                                <TableColumn fx:id="orderStatusColumn" text="Статус" prefWidth="105" minWidth="100"/>
                                <TableColumn fx:id="orderPriceColumn" text="Стоимость" prefWidth="80"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Двойной щелчок — открыть заказ" styleClass="form-hint"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="openOrderButton" text="Открыть в заказах" onAction="#onOpenOrder">
                                <tooltip><Tooltip text="Перейти к выбранному заказу на вкладке «Заказы»"/></tooltip>
                            </Button>
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>

            <padding>
                <Insets top="14" right="16" bottom="12" left="16"/>
            </padding>
        </HBox>
    </center>
</BorderPane>
